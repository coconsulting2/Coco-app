{
  "name": "@coco/web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "CocoConsulting React Router v7 framework-mode web app.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:integration": "vitest run --testPathPattern='\\.e2e\\.test\\.'"
  },
  "dependencies": {
    "@coco/contracts": "workspace:*",
    "@coco/db": "workspace:*",
    "@coco/integrations": "workspace:*",
    "@coco/shared-config": "workspace:*",
    "@coco/ui-kit": "workspace:*",
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-router/node": "^7.0.0",
    "@react-router/serve": "^7.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.1",
    "bcrypt": "^6.0.0",
    "cookie": "^1.0.1",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "isbot": "^5.1.17",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongo-sanitize": "^1.1.0",
    "mongodb": "^5.0.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.3",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^11.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.72.1",
    "react-router": "^7.0.0",
    "swagger-ui-dist": "^5.18.2",
    "tailwindcss": "^4.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
