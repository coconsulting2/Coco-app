    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "cypress": "^14.4.1",
    "cypress-file-upload": "^5.0.8",
    "jsdom": "^29.0.2",
    "msw": "^2.13.4",
    "supertest": "^7.2.2",
