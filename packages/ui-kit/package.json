{
  "name": "@coco/ui-kit",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Pure UI atoms (Button, Modal, Alert, Badge, InputField, etc.) — no domain logic, no data fetching.",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.4"
  }
}
