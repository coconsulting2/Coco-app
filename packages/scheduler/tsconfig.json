{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"],
      "@coco/db": ["../db/src/index.ts"],
      "@coco/db/*": ["../db/src/*"],
      "@coco/integrations": ["../integrations/src/index.ts"],
      "@coco/integrations/*": ["../integrations/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../db" },
    { "path": "../integrations" }
  ]
}
