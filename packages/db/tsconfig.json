{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"],
      "@coco/shared-config": ["../shared-config/src/index.ts"],
      "@coco/shared-config/*": ["../shared-config/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../shared-config" }]
}
