# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5173
NODE_ENV=development

# ─── PostgreSQL (Prisma) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5434/CocoScheme?schema=public

# ─── MongoDB (GridFS for files) ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017

# ─── AWS S3 ─────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=coco-consulting
AWS_S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── Encryption (AES-256-CBC for email/phone) ───────────────────────────────
AES_SECRET_KEY=

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_SKIP_IP_CHECK=true

# ─── Session cookie ─────────────────────────────────────────────────────────
SESSION_SECRET=
SESSION_COOKIE_NAME=coco_session
SESSION_MAX_AGE_DAYS=7

# ─── CSRF ───────────────────────────────────────────────────────────────────
CSRF_COOKIE_NAME=coco_csrf

# ─── API Key pepper (HMAC-SHA256) ───────────────────────────────────────────
API_KEY_HASH_PEPPER=

# ─── Email (Nodemailer) ─────────────────────────────────────────────────────
MAIL_USER=
MAIL_PASSWORD=

# ─── Wise (FX, OAuth2) ──────────────────────────────────────────────────────
WISE_CLIENT_ID=
WISE_CLIENT_SECRET=
WISE_SANDBOX_CERT_PATH=./certs/wise/sandbox-CERTIFICATE.pem
WISE_SANDBOX_KEY_PATH=./certs/wise/sandbox-PRIVATE-KEY.key
WISE_SANDBOX_CA_PATH=./certs/wise/wise-sandbox.pem
WISE_PROD_CERT_PATH=./certs/wise/production-CERTIFICATE.pem
WISE_PROD_KEY_PATH=./certs/wise/production-PRIVATE-KEY.key
WISE_PROD_CA_PATH=./certs/wise/wise-production.pem

# ─── Banxico (FX rates) ─────────────────────────────────────────────────────
BANXICO_API_KEY=
BMX_API_URL=https://www.banxico.org.mx/SieAPIRest/service/v1

# ─── SAT CFDI Consultation (SOAP) ───────────────────────────────────────────
SAT_WSDL_URL=https://consultaqr.facturaelectronica.sat.gob.mx/ConsultaCFDIService.svc?wsdl
SAT_REQUEST_TIMEOUT_MS=10000

# ─── Duffel (Flights & Stays) ───────────────────────────────────────────────
FLIGHT_PROVIDER=mock
DUFFEL_ACCESS_TOKEN=
HOTEL_PROVIDER=mock
STAYS_SEARCH_RADIUS_KM=10

# ─── Web Push (M3-006) ──────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@coconsulting.com

# ─── Scheduler (M2-006 cron) ────────────────────────────────────────────────
SCHEDULER_ENABLED=true

# ─── Prisma ─────────────────────────────────────────────────────────────────
PRISMA_DISABLE_TRIGGERS=false

# ─── Dev auth bypass (DANGEROUS — dev only) ─────────────────────────────────
MOCK_AUTH=false

# ─── Chat encryption (internal messaging) ───────────────────────────────────
CHAT_CURSOR_SECRET=
CHAT_MESSAGE_SECRET=

# ─── Ditta org setup ────────────────────────────────────────────────────────
DITTA_RFC=
DITTA_ADMIN_INITIAL_PASSWORD=

# ─── Cypress E2E ────────────────────────────────────────────────────────────
CYPRESS_BASE_URL=https://localhost:5173
CYPRESS_SOLICITANTE_USER=andres.gomez
CYPRESS_SOLICITANTE_PASSWORD=andres123
CYPRESS_AV_USER=paula.martinez
CYPRESS_AV_PASSWORD=paula456
CYPRESS_CPP_USER=carlos.ramos
CYPRESS_CPP_PASSWORD=carlos789
CYPRESS_N1_USER=laura.flores
CYPRESS_N1_PASSWORD=laura321
CYPRESS_N2_USER=diego.hernandez
CYPRESS_N2_PASSWORD=diego654
CYPRESS_ADMIN_USER=admin
CYPRESS_ADMIN_PASSWORD=admin123
