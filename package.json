{
  "name": "coco-app",
  "version": "1.0.0",
  "private": true,
  "description": "CocoConsulting travel management system — bun workspaces monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @coco/web dev",
    "build": "bun --filter @coco/web build",
    "start": "bun --filter @coco/web start",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun --filter '*' test",
    "test:e2e": "bun --filter @coco/web test:e2e",
    "test:e2e:open": "bun --filter @coco/web test:e2e:open",
    "scheduler:start": "bun --filter @coco/scheduler start",
    "scheduler:dev": "bun --filter @coco/scheduler dev",
    "contracts:generate": "bun --filter @coco/contracts generate",
    "db:migrate": "bun --filter @coco/db migrate",
    "db:generate": "bun --filter @coco/db generate",
    "db:studio": "bun --filter @coco/db studio",
    "db:seed": "bun --filter @coco/db seed",
    "db:seed:dummy": "bun --filter @coco/db seed:dummy",
    "db:seed:usability": "bun --filter @coco/db seed:usability",
    "db:seed:orgs": "bun --filter @coco/db seed:orgs",
    "db:reset": "bun --filter @coco/db reset",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:clean": "docker compose -f docker-compose.dev.yml down -v",
    "docker:prod": "docker compose up -d",
    "docker:prod:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "bcrypt",
    "prisma"
  ],
  "engines": {
    "bun": ">=1.1.0"
  }
}
