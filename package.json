{
  "name": "coco-app",
  "version": "1.0.0",
  "type": "module",
  "description": "CocoConsulting travel management system \u2014 unified React Router v7 framework mode app (hexagonal, vertical slicing).",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "dummy_db": "bunx prisma db push --force-reset && node prisma/seed.js dev",
    "empty_db": "bunx prisma db push --force-reset && node prisma/seed.js",
    "migrate": "bunx prisma migrate dev",
    "generate": "bunx prisma generate",
    "studio": "bunx prisma studio",
    "seed": "node prisma/seed-orgs.js",
    "test:integration": "vitest run --testPathPattern='\\.e2e\\.test\\.'",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:clean": "docker compose -f docker-compose.dev.yml down -v",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f coco-app",
    "docker:dev:restart": "docker compose -f docker-compose.dev.yml up -d --force-recreate coco-app",
    "docker:dev:reset": "docker compose -f docker-compose.dev.yml exec -T coco-app sh -c 'bunx prisma db push --force-reset && node prisma/seed.js dev'",
    "docker:prisma": "docker compose -f docker-compose.dev.yml exec -T coco-app bunx prisma",
    "docker:prod": "docker compose up -d",
    "docker:prod:down": "docker compose down",
    "seed:reference": "node prisma/seed.js",
    "seed:dummy": "node prisma/seed.js dev",
    "seed:usability": "node prisma/seed-usability.js",
    "seed:orgs": "node prisma/seed-orgs.js",
    "permissions:sync": "node prisma/seed.js",
    "docker:seed:reference": "docker compose -f docker-compose.dev.yml exec -T coco-app node prisma/seed.js",
    "docker:seed:dummy": "docker compose -f docker-compose.dev.yml exec -T coco-app node prisma/seed.js dev",
    "docker:seed:usability": "docker compose -f docker-compose.dev.yml exec -T coco-app node prisma/seed-usability.js",
    "docker:seed:orgs": "docker compose -f docker-compose.dev.yml exec -T coco-app node prisma/seed-orgs.js",
    "docker:permissions:sync": "docker compose -f docker-compose.dev.yml exec -T coco-app node prisma/seed.js",
    "docker:data:reset": "docker compose -f docker-compose.dev.yml exec -T coco-app sh -c 'bunx prisma db push --force-reset && node prisma/seed.js dev'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@duffel/api": "^4.25.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.0",
    "@react-router/node": "^7.0.0",
    "@react-router/serve": "^7.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.1",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "cookie": "^1.0.1",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.5.11",
    "isbot": "^5.1.17",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongo-sanitize": "^1.1.0",
    "mongodb": "^5.0.0",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.3",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-http": "^11.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.72.1",
    "react-router": "^7.0.0",
    "soap": "^1.8.0",
    "swagger-ui-dist": "^5.18.2",
    "tailwindcss": "^4.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-router/dev": "^7.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "cypress": "^14.4.1",
    "cypress-file-upload": "^5.0.8",
    "eslint": "^9.0.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.4",
    "openapi-typescript": "^7.4.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.16.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "bcrypt",
    "prisma"
  ]
}
